# Export in your shell; this file is documentation and is not auto-loaded.
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# Optional:
QQ_BOT_TRANSPORT=websocket
QQ_BOT_HOST=127.0.0.1
QQ_BOT_PORT=8080
QQ_BOT_DATA_DIR=./data
QQ_BOT_WORKERS=2
# Empty allowlists accept all users/groups authorized by QQ.
QQ_BOT_ALLOWED_USERS=
QQ_BOT_ALLOWED_GROUPS=
QQ_BOT_API_BASE=https://api.bot.qq.com
# markdown (default) or plain; unavailable Markdown permission falls back visibly.
QQ_BOT_MESSAGE_FORMAT=markdown
# Program upload size limit per attachment, in MiB (1..200).
QQ_BOT_MAX_ATTACHMENT_MB=50
QQ_BOT_CODEX_BIN=codex
QQ_BOT_CODEX_WORKSPACE=./data/workspace
# approve-for-me (default), read-only, or workspace-write
QQ_BOT_CODEX_SANDBOX=approve-for-me
# 0 disables the Codex execution timeout; positive values set a limit in seconds.
QQ_BOT_CODEX_TIMEOUT=0
# Empty uses the model already configured in Codex.
QQ_BOT_CODEX_MODEL=
# Optional cpolar reserved domain settings (must already belong to your account).
# QQ_BOT_CPOLAR_SUBDOMAIN=your-reserved-subdomain
# QQ_BOT_CPOLAR_REGION=cn_vip
# For a reserved custom domain, use HOSTNAME instead of SUBDOMAIN:
# QQ_BOT_CPOLAR_HOSTNAME=bot.example.com
# QQ_BOT_CPOLAR_BIN=cpolar

